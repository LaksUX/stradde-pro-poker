# Copy to .env.local and fill in from your Supabase project's
# Settings → API page. Never commit the real .env.local.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Optional — the Home screen's notification toggle stays hidden without it.
# Generate with `npx web-push generate-vapid-keys`; see
# supabase/functions/send-push/index.ts for the full push-notification setup.
VITE_VAPID_PUBLIC_KEY=
